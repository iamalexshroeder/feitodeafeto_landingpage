# Copie para .env (local) ou configure no painel da hospedagem.

# Domínio canônico, sem barra no fim. Usado no canonical, sitemap, Open Graph e JSON-LD.
SITE_URL=https://feitodeafeto.com.br

# Só "true" quando o site puder ser indexado pelo Google. Em branco = noindex + robots.txt bloqueando.
PUBLIC_INDEXABLE=

