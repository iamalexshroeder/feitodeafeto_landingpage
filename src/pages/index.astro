---
// Página inicial = loja — Figma "E-commerce — nova versão" (página 215:112, Desktop 1440 215:113; versão
// como no site: 226:123 desktop e 227:328 mobile).
// Ordem do Figma: faixa + menu, hero, avaliações, benefícios, modelos, aromas, faixa de ajuda, como fazemos,
// quem faz, depoimentos, dúvidas, CTA final e rodapé (no celular, como fazemos vem antes da faixa). Melhorias: avaliações sob o hero e seção de
// aromas (o menu do Figma aponta para ela). Cada produto tem a sua página em /produtos/<produto>.
import Base from '../layouts/Base.astro';
import LojaHeader from '../components/loja/LojaHeader.astro';
import LojaHero from '../components/loja/LojaHero.astro';
import Avaliacoes from '../components/loja/Avaliacoes.astro';
import Vitrine from '../components/loja/Vitrine.astro';
import AromasLoja from '../components/loja/AromasLoja.astro';
import AjudaEscura from '../components/loja/AjudaEscura.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import Founder from '../components/sections/Founder.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import HowWeMake from '../components/sections/HowWeMake.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import MobileCta from '../components/sections/MobileCta.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import { faq, models } from '../data/content';

// Produtos com preço viram Product/Offer no JSON-LD.
const products = models.flatMap((m) => {
  if (!m.order || m.media.kind !== 'photo') return [];
  const prices = m.order.type === 'kit' ? m.order.sizes.map((s) => s.priceValue) : [m.priceValue ?? 0];
  return [{ id: m.id, name: m.name, description: m.description, image: m.media.src, prices }];
});
---

<Base faq={faq} products={products}>
  <LojaHeader slot="header" />
  <LojaHero />
  <Avaliacoes />
  <TrustStrip />
  <Vitrine />
  {/* Ordem do Figma: desktop aromas → faixa de ajuda → como fazemos → quem faz → depoimentos;
      celular: aromas → como fazemos → faixa de ajuda → quem faz → depoimentos. */}
  <div class="flex flex-col max-lg:[&>#aromas]:-order-2 max-lg:[&>#como-fazemos]:-order-1">
    <AromasLoja />
    <AjudaEscura />
    <HowWeMake />
    <Founder />
    <Testimonials />
  </div>
  <Faq />
  <FinalCta />
  <MobileCta />
  <CartDrawer />
  <SiteFooter slot="footer" />
</Base>
