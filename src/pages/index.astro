---
// Landing page — Figma "Feito de Afeto — Landing Page" (Desktop 1440, node 1:49; Mobile 390, node 47:37).
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import Collection from '../components/sections/Collection.astro';
import Founder from '../components/sections/Founder.astro';
import HowWeMake from '../components/sections/HowWeMake.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import MobileCta from '../components/sections/MobileCta.astro';
import CartDrawer from '../components/cart/CartDrawer.astro';
import { faq, models } from '../data/content';

// Produtos com preço viram Product/Offer no JSON-LD (o modelo "em breve" fica de fora).
const products = models.flatMap((m) => {
  if (!m.order || m.media.kind !== 'photo') return [];
  const prices = m.order.type === 'kit' ? m.order.sizes.map((s) => s.priceValue) : [m.priceValue ?? 0];
  return [{ id: m.id, name: m.name, description: m.description, image: m.media.src, prices }];
});
---

<Base faq={faq} products={products}>
  <SiteHeader slot="header" />
  <Hero />
  <TrustStrip />
  <Collection />
  <Founder />
  <HowWeMake />
  <Testimonials />
  <Faq />
  <FinalCta />
  <MobileCta />
  <CartDrawer />
  <SiteFooter slot="footer" />
</Base>
