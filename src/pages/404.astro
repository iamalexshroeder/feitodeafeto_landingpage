---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada | Feito de Afeto" description="Esta página não existe." noindex>
  <section aria-labelledby="erro-titulo" class="mx-auto max-w-6xl px-4 py-24">
    <h1 id="erro-titulo" class="text-4xl font-semibold">Página não encontrada</h1>
    <p class="mt-4">O endereço que você procurou não existe ou mudou de lugar.</p>
    <a href="/" class="mt-8 inline-flex min-h-11 items-center underline">Voltar para o início</a>
  </section>
</Base>
