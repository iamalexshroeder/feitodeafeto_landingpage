---
// Página de produto: /produtos/<produto> (uma para cada card da vitrine da página inicial).
// Reaproveita o bloco de compra (galeria de aromas, tamanho do kit, sacola e WhatsApp) com o nome do
// produto como h1, e mostra os outros modelos embaixo. Figma: "Produto — Desktop 1440" e "Produto — Mobile 390".
import Base from '../../layouts/Base.astro';
import LojaHeader from '../../components/loja/LojaHeader.astro';
import Vitrine from '../../components/loja/Vitrine.astro';
import ModelFeature from '../../components/sections/ModelFeature.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import CartDrawer from '../../components/cart/CartDrawer.astro';
import MobileCta from '../../components/sections/MobileCta.astro';
import { lojaProdutos, modeloDo } from '../../data/loja';

export function getStaticPaths() {
  return lojaProdutos.map((p) => ({ params: { produto: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
const produto = lojaProdutos.find((p) => p.slug === slug)!;
const model = modeloDo(produto);
const outros = lojaProdutos.filter((p) => p.slug !== slug);

// JSON-LD: o produto desta página (o kit leva os dois preços, 3 de 40g e 3 de 100g).
const prices = model.order?.type === 'kit' ? model.order.sizes.map((s) => s.priceValue) : [model.priceValue ?? 0];
const image = model.media.kind === 'photo' ? model.media.src : produto.foto;
const products = [{ id: model.id, name: model.name, description: model.description, image, prices }];
---

<Base title={produto.seoTitle} description={produto.seoDescription} products={products}>
  <LojaHeader slot="header" base="/" />
  <nav aria-label="Você está aqui" class="container-page pt-6 text-small text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      <li>
        <a href="/" class="transition-colors hover:text-bordo">
          Início
        </a>
      </li>
      <li aria-hidden="true">›</li>
      <li>
        <a href="/#modelos" class="transition-colors hover:text-bordo">
          Modelos
        </a>
      </li>
      <li aria-hidden="true">›</li>
      <li aria-current="page" class="font-semibold text-ink">
        {model.name}
      </li>
    </ol>
  </nav>
  <ModelFeature model={model} headingLevel={1} />
  <TrustStrip />
  <Vitrine
    produtos={outros}
    label="Veja também"
    titulo="Outros jeitos de levar afeto para casa"
    texto="Todas feitas à mão, sob encomenda, com cera vegetal e pote de vidro."
  />
  <FinalCta />
  <MobileCta />
  <CartDrawer />
  <SiteFooter slot="footer" />
</Base>
