---
// Figma: "Footer" (2:167).
import { site, whatsappLink } from '../../config/site';
---

<footer class="bg-bordo-dark text-rosa">
  <div class="container-page flex flex-col gap-8 py-14 lg:flex-row lg:items-center lg:justify-between">
    <img src="/brand/logo-rosa.svg" alt={site.name} width="70" height="56" class="h-14 w-auto" loading="lazy" />
    <ul class="flex flex-wrap gap-x-8 gap-y-2">
      <li><a href="#colecao" class="hover:text-white">Coleção</a></li>
      <li><a href={whatsappLink('Olá! Vim pelo site da Feito de Afeto.')} target="_blank" rel="noopener" class="hover:text-white">WhatsApp</a></li>
      <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram</a></li>
    </ul>
    <div class="flex flex-col gap-1 opacity-70 lg:items-end">
      <p>Velas aromáticas feitas à mão · Entrega em {site.delivery}</p>
      <p class="text-small">Projeto conceitual de portfólio. Marca fictícia.</p>
    </div>
  </div>
</footer>
