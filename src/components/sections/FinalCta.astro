---
// Figma: "CTA Final" (2:159; mobile 49:146). Painel rosa suave no celular, branco no desktop.
// O link do Instagram só aparece no celular (no desktop está no rodapé).
import Button from '../ui/Button.astro';
import { site, whatsappLink } from '../../config/site';
---

<section aria-labelledby="cta-final-titulo" class="lg:bg-white">
  <div class="container-page py-16 lg:py-24">
    <div
      class="flex flex-col items-center gap-6 rounded-[var(--radius-panel)] bg-rosa-soft px-6 lg:bg-creme py-16 text-center md:px-20 lg:py-24"
      data-reveal="zoom"
    >
      <h2 id="cta-final-titulo" class="max-w-[824px] text-h2 text-bordo">
        Leve um pouco de afeto para casa.
      </h2>
      <p class="max-w-[640px] text-body-l text-ink">Escolha o seu aroma e fale com a gente. Respondemos rapidinho.</p>
      <Button href={whatsappLink('Olá! Quero fazer um pedido.')} variant="whatsapp">
        Pedir pelo WhatsApp
      </Button>
      <p class="text-small text-ink">
        Entrega em {site.delivery}{' '}
        <span class="lg:hidden">·{' '}</span>
        <br class="max-lg:hidden" />
        Pagamento via {site.payment}{' '}
        <span class="lg:hidden">
          · Veja mais no Instagram{' '}
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener"
            class="font-semibold text-bordo underline underline-offset-4 hover:text-bordo-dark"
          >
            {site.instagramHandle}
          </a>
        </span>
      </p>
    </div>
  </div>
</section>
