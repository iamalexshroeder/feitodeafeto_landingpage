---
// Figma: "Hero" (desktop 1:63, mobile 47:44).
// Desktop: foto de ponta a ponta, sem véu (Figma), com título e label em bordô e texto em tinta sobre a
// parede clara — contraste AA conferido em npm run contrast. Mobile: sem imagem; texto em bordô-escuro
// sobre o creme, "Ver a coleção" em rosa e estrelas sobre a prova social.
import Button from '../ui/Button.astro';
---

<section aria-labelledby="hero-titulo" class="relative isolate overflow-hidden bg-creme lg:min-h-[640px]">
  {/* Só no desktop (≥1024px). No celular o hero é só texto: a imagem fica fora do layout e não baixa
      nada (abaixo de 1024px o src é um GIF vazio embutido). */}
  <picture class="hidden lg:absolute lg:inset-0 lg:-z-10 lg:block">
    <source
      media="(min-width: 64rem)"
      srcset="/img/hero-banner-960.webp 960w, /img/hero-banner.webp 1440w"
      sizes="100vw"
    />
    <img
      src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
      alt="Vela Baunilha da Feito de Afeto sobre a mesa de cabeceira, ao lado de um abajur aceso"
      width="1440"
      height="701"
      fetchpriority="high"
      class="hero-media size-full object-cover object-[75%_center]"
    />
  </picture>

  <div class="container-page flex flex-col py-16 lg:min-h-[640px] lg:justify-center lg:py-[72px]">
    <div class="flex max-w-[708px] flex-col items-start gap-8">
      <p class="text-label uppercase text-bordo">Velas aromáticas artesanais</p>
      <h1 id="hero-titulo" class="text-display text-bordo-dark lg:text-bordo">
        Velas feitas à mão para perfumar seus momentos de afeto.
      </h1>
      <p class="max-w-[544px] text-body-l text-bordo-dark lg:text-ink">
        Cera vegetal, aromas marcantes e um pote de vidro que continua com você depois da última chama.{' '}
        <span class="max-lg:hidden">São cinco aromas, cada um com a sua história.</span>
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="#modelos" external={false} class="lg:bg-bordo-dark lg:hover:bg-bordo">
          Escolher minha vela
        </Button>
        <Button
          href="#colecao"
          variant="soft"
          external={false}
          class="lg:bg-white lg:hover:bg-rosa lg:hover:text-bordo"
        >
          Ver a coleção
        </Button>
      </div>
      <div class="flex flex-col gap-1 max-lg:w-full max-lg:items-center max-lg:text-center lg:hidden">
        <p class="hero-stars" aria-hidden="true">
          ★★★★★
        </p>
        <p class="text-ink">Mais de 100 velas vendidas.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Estrelas decorativas do mobile (Figma "Prova social"); cor só de ilustração, sem texto. */
  .hero-stars {
    color: var(--color-estrela);
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 4px;
  }
</style>
