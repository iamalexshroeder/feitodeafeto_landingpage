---
// Coleção: intro (Figma 1:105) → carrossel de aromas → os modelos + kit (blocos no layout dos antigos
// "Candle 01…05") → faixa "Não sabe qual escolher?" (1:226).
// Os modelos e a faixa usam o efeito de pilha: cada bloco para sob o menu e o próximo desliza por cima.
import AromaCarousel from './AromaCarousel.astro';
import ModelFeature from './ModelFeature.astro';
import Button from '../ui/Button.astro';
import { models } from '../../data/content';
import { whatsappLink } from '../../config/site';
---

<section id="colecao" aria-labelledby="colecao-titulo" class="pb-8 lg:pb-12">
  <div class="container-page flex flex-col items-center gap-6 pt-20 pb-10 text-center lg:pt-32 lg:pb-12" data-reveal>
    <p class="text-label text-bordo uppercase">A coleção</p>
    <h2 id="colecao-titulo" class="max-w-[1152px] text-h2 text-ink">Cinco aromas e cinco jeitos de dizer afeto.</h2>
    <p class="max-w-[624px] text-body-l text-muted">
      Todas as velas são de cera vegetal, em pote de vidro, feitas à mão e sob encomenda.
    </p>
  </div>

  <AromaCarousel />
</section>

<section id="modelos" aria-labelledby="modelos-titulo">
  <div class="container-page flex flex-col items-center gap-6 pt-16 pb-12 text-center lg:pt-24 lg:pb-24" data-reveal>
    <p class="text-label text-bordo uppercase">Os modelos</p>
    <h2 id="modelos-titulo" class="max-w-[504px] text-h2 text-ink">Quatro jeitos de levar o seu aroma para casa.</h2>
  </div>

  <div class="stack" data-stack>
    {
      models.map((model, i) => (
        <div class="stack-card" style={`--i:${i}`}>
          <ModelFeature model={model} reverse={i % 2 === 1} />
        </div>
      ))
    }

    <div class="stack-card" style={`--i:${models.length}`}>
      <aside aria-labelledby="ajuda-titulo" class="container-page py-8 lg:py-12">
        <div
          class="flex flex-col items-start gap-8 rounded-[var(--radius-media)] bg-bordo px-8 py-10 md:px-[72px] md:py-14 lg:flex-row lg:items-center lg:justify-between"
          data-reveal
        >
          <div class="flex max-w-[624px] flex-col gap-4">
            <h2 id="ajuda-titulo" class="text-h3 tracking-[-3px] text-white">Não sabe qual escolher?</h2>
            <p class="text-body-l text-rosa">
              Conta pra gente o ambiente e o clima que você quer. A gente indica o aroma e o modelo certos pelo
              WhatsApp.
            </p>
          </div>
          <Button href={whatsappLink('Olá! Não sei qual vela escolher, pode me ajudar?')} variant="ondark">
            Me ajuda a escolher
          </Button>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Só vale quando o script confirmou que cada bloco cabe na tela (.stack-on). */
  .stack-on .stack-card {
    position: sticky;
    top: calc(var(--stack-top, 96px) + var(--i) * 8px);
    background: var(--color-creme);
    border-radius: 40px 40px 0 0;
    transform-origin: 50% 0;
    transform: scale(calc(1 - var(--p, 0) * 0.06));
  }
  .stack-on .stack-card + .stack-card {
    box-shadow: 0 -24px 48px -32px rgb(42 20 24 / 0.35);
    border-top: 1px solid var(--color-line);
  }
  /* Véu que escurece levemente o bloco que vai ficando para trás. */
  .stack-on .stack-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-ink);
    opacity: calc(var(--p, 0) * 0.12);
    pointer-events: none;
  }
</style>

<script>
  // Pilha de seções: liga o sticky só se todos os blocos couberem na tela e, ao rolar,
  // encolhe/escurece o bloco que está sendo coberto (--p de 0 a 1).
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (stack) {
    const cards = [...stack.querySelectorAll<HTMLElement>('.stack-card')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const nav = document.querySelector<HTMLElement>('.site-nav');
    let frame = 0;

    const layout = () => {
      const top = (nav?.offsetHeight ?? 64) + 8;
      stack.style.setProperty('--stack-top', `${top}px`);
      const fits =
        innerWidth >= 1024 && cards.every((c, i) => c.offsetHeight <= innerHeight - top - i * 8);
      stack.classList.toggle('stack-on', fits);
      update();
    };

    const update = () => {
      frame = 0;
      if (!stack.classList.contains('stack-on') || reduce.matches) {
        cards.forEach((c) => c.style.removeProperty('--p'));
        return;
      }
      cards.forEach((card, i) => {
        const next = cards[i + 1];
        if (!next) return;
        const a = card.getBoundingClientRect();
        const b = next.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, 1 - (b.top - a.top) / a.height));
        card.style.setProperty('--p', p.toFixed(3));
      });
    };

    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    addEventListener('resize', layout);
    reduce.addEventListener('change', update);
    document.fonts?.ready.then(layout);
    layout();
  }
</script>
