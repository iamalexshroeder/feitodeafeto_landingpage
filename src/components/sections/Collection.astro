---
// Coleção: intro (Figma 1:105) → carrossel de aromas → os modelos + kit (blocos no layout dos antigos
// "Candle 01…05") → faixa "Não sabe qual escolher?" (1:226).
// Os modelos e a faixa só esmaecem ao entrar na tela (data-reveal), sem efeito de pilha.
import AromaCarousel from './AromaCarousel.astro';
import ModelFeature from './ModelFeature.astro';
import Button from '../ui/Button.astro';
import { models } from '../../data/content';
import { whatsappLink } from '../../config/site';
---

<section id="colecao" aria-labelledby="colecao-titulo" class="pb-8 lg:bg-white lg:pb-12">
  <div class="container-page flex flex-col items-center gap-6 pt-16 pb-10 text-center lg:pt-12 lg:pb-12" data-reveal>
    <p class="text-label uppercase text-bordo">A coleção</p>
    <h2 id="colecao-titulo" class="max-w-[1152px] text-h2 text-ink">
      Cinco aromas e cinco jeitos de dizer afeto
    </h2>
    <p class="max-w-[624px] text-body-l text-muted">
      Todas as velas são de cera vegetal, em pote de vidro, feitas à mão e sob encomenda.
    </p>
  </div>

  <AromaCarousel />
</section>

<section id="modelos" aria-labelledby="modelos-titulo" class="lg:bg-white">
  <div class="container-page flex flex-col items-center gap-6 pt-10 pb-0 text-center lg:pt-24 lg:pb-24" data-reveal>
    <p class="text-label uppercase text-bordo">Os modelos</p>
    <h2 id="modelos-titulo" class="max-w-[504px] text-h2 text-ink">
      {/* Como no Figma: "Quatro" no celular (47:37) e "Três" no desktop (1:49). */}
      <span class="lg:hidden">Quatro</span>
      <span class="max-lg:hidden">Três</span> jeitos de levar o seu aroma para casa
    </h2>
    <p class="text-small text-muted">
      Escolha o tamanho, o aroma e monte o seu pedido. Todas feitas à mão, sob encomenda.
    </p>
  </div>

  {/* Desktop: blocos alternam branco e creme, de ponta a ponta (Figma). */}
  {models.map((model, i) => (
    <div class:list={[i % 2 === 1 && 'lg:bg-creme']}>
      <ModelFeature model={model} reverse={i % 2 === 1} />
    </div>
  ))}

  <aside aria-labelledby="ajuda-titulo" class="container-page py-8 lg:py-12">
    <div
      class="flex flex-col items-start gap-8 rounded-[var(--radius-media)] bg-rosa px-8 lg:bg-creme py-10 md:px-[72px] md:py-14 lg:flex-row lg:items-center lg:justify-between"
      data-reveal
    >
      <div class="flex max-w-[624px] flex-col gap-4">
        <h2 id="ajuda-titulo" class="text-h3 text-bordo lg:text-bordo-dark lg:tracking-[-3px]">
          Não sabe qual escolher?
        </h2>
        <p class="text-body-l text-bordo-dark lg:text-bordo">
          Conta pra gente o ambiente e o clima que você quer. A gente indica o aroma e o modelo certos pelo WhatsApp.
        </p>
      </div>
      <Button href={whatsappLink('Olá! Não sei qual vela escolher, pode me ajudar?')}>Me ajuda a escolher</Button>
    </div>
  </aside>
</section>
