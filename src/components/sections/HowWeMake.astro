<section id="como-fazemos" aria-labelledby="como-titulo" class="bg-rosa-soft lg:bg-bordo-dark">
  <div class="container-page flex flex-col items-center gap-10 py-20 lg:gap-14 lg:py-24">
    <div class="flex flex-col items-center gap-4 text-center" data-reveal>
      <p class="text-label uppercase text-bordo lg:text-rosa">Como fazemos</p>
      <h2 id="como-titulo" class="max-w-[760px] text-h2 text-ink lg:text-rosa">
        Do derretimento ao laço, tudo passa pelas nossas mãos
      </h2>
    </div>
    <!-- Cards com a mesma altura (o grid estica todos até o mais alto). -->
    <ol class="grid w-full gap-6 md:grid-cols-3">
      {steps.map((step, i) => (
        <li
          class="flex flex-col items-center gap-4 rounded-[var(--radius-card)] bg-white px-10 py-10 text-center lg:px-9"
          data-reveal
          style={`--reveal-delay: ${i * 100}ms`}
        >
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="text-bordo">
            <path d={icons[step.icon]} fill="currentColor" />
          </svg>
          <h3 class="text-title text-ink">{step.title}</h3>
          <p class="text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
