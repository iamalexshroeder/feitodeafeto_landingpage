---
// Seção "Quem faz" — referência: faixa da fundadora da LP Cellea (Moodboard › Lp's).
// Foto da fundadora (Figma 192:111 / 192:113). Desktop (15:53): painel creme com a foto à esquerda
// (343 de 1200) e o texto em bordô à direita, com "Falar com a Giovaneli". Celular (48:139): foto no topo e o mesmo painel
// creme do desktop, com a citação, a assinatura e "Falar com a Giovaneli" (sem o parágrafo).
import Button from '../ui/Button.astro';
import { whatsappLink } from '../../config/site';
---

<section id="quem-faz" aria-labelledby="quem-faz-titulo" class="bg-white">
  <div class="container-page pt-10 pb-16 lg:py-24">
    <div class="grid overflow-hidden rounded-[var(--radius-panel)] bg-creme lg:grid-cols-[minmax(0,343fr)_minmax(0,857fr)]">
      <figure class="relative aspect-[343/369] lg:aspect-auto lg:min-h-[608px]" data-reveal="zoom">
        <img
          src="/img/fundadora.webp"
          srcset="/img/fundadora-400.webp 400w, /img/fundadora.webp 686w"
          sizes="(min-width: 64rem) 343px, 100vw"
          alt="Giovaneli Schroeder, fundadora e artesã da Feito de Afeto"
          width="686"
          height="1218"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 size-full object-cover object-[50%_15%] lg:object-center"
        />
      </figure>

      <div
        class="flex flex-col items-start gap-8 px-8 py-12 md:px-16 lg:py-20"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <p class="text-label uppercase text-bordo">Quem faz</p>
        <blockquote>
          <h2 id="quem-faz-titulo" class="text-h2 text-bordo">
            “Iniciei essa trajetória pelo encantamento em unir aromas aconchegantes com momentos especiais.”
          </h2>
        </blockquote>
        <p class="max-w-[560px] text-body-l text-bordo max-lg:hidden">
          Cada detalhe foi pensado para que você possa fazer parte dessa história e possa sentir o afeto.
        </p>
        <div class="flex flex-col gap-1">
          <p class="text-title text-muted">Giovaneli Schroeder</p>
          <p class="text-small text-bordo">Fundadora e artesã da Feito de Afeto</p>
        </div>
        <Button
          href={whatsappLink('Olá, Giovaneli! Vim pelo site e queria conversar sobre as velas.')}
          variant="primary"
        >
          Falar com a Giovaneli
        </Button>
      </div>
    </div>
  </div>
</section>
