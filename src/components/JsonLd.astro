---
import { site, canonicalUrl } from '../config/site';

export interface FaqItem {
  question: string;
  answer: string;
}

/** Produto à venda: um preço = Offer; vários (kit) = AggregateOffer. Preços em R$. */
export interface ProductItem {
  id: string;
  name: string;
  description: string;
  image: string;
  prices: number[];
}

interface Props {
  title: string;
  description: string;
  faq?: FaqItem[];
  products?: ProductItem[];
}

const { title, description, faq = [], products = [] } = Astro.props;
const base = new URL('/', Astro.site).href;
const pageUrl = canonicalUrl(Astro.url.pathname, Astro.site);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${base}#organization`,
    name: site.name,
    url: base,
    logo: new URL(site.logo, Astro.site).href,
    slogan: site.tagline,
    sameAs: [site.instagram],
    areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@type': 'WebSite',
    '@id': `${base}#website`,
    url: base,
    name: site.name,
    inLanguage: site.lang,
    publisher: { '@id': `${base}#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: site.lang,
    isPartOf: { '@id': `${base}#website` },
    about: { '@id': `${base}#organization` },
  },
];

// Feito sob encomenda, entregue na área atendida.
const offerBase = {
  priceCurrency: 'BRL',
  availability: 'https://schema.org/MadeToOrder',
  seller: { '@id': `${base}#organization` },
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
};
for (const p of products) {
  const low = Math.min(...p.prices);
  const high = Math.max(...p.prices);
  graph.push({
    '@type': 'Product',
    '@id': `${pageUrl}#${p.id}`,
    name: p.name,
    description: p.description,
    image: new URL(p.image, Astro.site).href,
    brand: { '@id': `${base}#organization` },
    material: 'Cera vegetal',
    offers:
      p.prices.length > 1
        ? {
            '@type': 'AggregateOffer',
            ...offerBase,
            lowPrice: low.toFixed(2),
            highPrice: high.toFixed(2),
            offerCount: p.prices.length,
          }
        : { '@type': 'Offer', ...offerBase, price: low.toFixed(2), url: `${pageUrl}#${p.id}` },
  });
}

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}

const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
