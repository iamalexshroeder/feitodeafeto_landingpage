---
// Sacola: painel lateral (<dialog>) em 3 passos — 1. Sacola, 2. Entrega, 3. Revisar e enviar.
// O pedido sai como mensagem pronta no WhatsApp; pagamento (Pix) e entrega são combinados na conversa.
// Abre por qualquer elemento com [data-open-cart]. Sem JS, nada disso aparece (os botões diretos de
// WhatsApp continuam funcionando).
import { site } from '../../config/site';

const steps = ['Sacola', 'Entrega', 'Enviar'];
---

<div class="cart-toast" role="status" aria-live="polite" data-cart-toast>
  <img
    src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
    alt=""
    width="48"
    height="48"
    class="size-12 flex-none rounded-lg object-cover"
    data-cart-toast-img
  />
  <div class="flex min-w-0 flex-col">
    <span class="text-small font-semibold text-ink">Adicionado à sacola</span>
    <span class="truncate text-small text-muted" data-cart-toast-text></span>
  </div>
  <button
    type="button"
    class="ml-auto flex-none text-small font-semibold text-bordo transition-colors hover:text-bordo-dark"
    data-open-cart
  >
    Ver sacola (<span data-cart-toast-count>0</span>)
  </button>
</div>

<dialog class="cart" aria-labelledby="sacola-titulo" data-cart>
  <div class="cart__panel">
    <header class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
      <h2 id="sacola-titulo" class="text-title text-ink">
        Sua sacola
      </h2>
      <button type="button" class="cart__close" data-cart-close aria-label="Fechar a sacola">
        Fechar
      </button>
    </header>

    <div class="px-6 pt-4">
      <ol class="flex gap-2" aria-label="Etapas do pedido" data-cart-steps>
        {steps.map((label, i) => (
          <li class="cart__step" data-step-tab={i}>
            <span class="cart__step-n" aria-hidden="true">
              {i + 1}
            </span>
            {label}
          </li>
        ))}
      </ol>
      {/* Barra de progresso contínua (sem intervalos): enche 1/3, 2/3 e 3/3 conforme o passo. */}
      <div class="cart__progress" aria-hidden="true">
        <span data-cart-progress></span>
      </div>
    </div>

    <!-- 1. Sacola -->
    <section class="cart__body" data-step="0" aria-label="Itens da sacola">
      <div class="ticket" data-ticket>
        <div class="flex flex-col gap-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col">
              <p class="text-label uppercase text-bordo">Seu pedido</p>
              <p class="text-small text-muted" data-ticket-date></p>
            </div>
            <img src="/brand/logo.svg" alt="" width="50" height="40" class="h-10 w-auto" />
          </div>
          <hr class="ticket__rule" />
          <ul class="flex flex-col divide-y divide-dashed divide-line" data-cart-list></ul>
          <hr class="ticket__rule" />
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-semibold text-ink">
              Total <span class="text-small font-normal text-muted">(sem a entrega)</span>
            </span>
            <span class="text-title text-ink" data-cart-total aria-live="polite">
              R$ 0,00
            </span>
          </div>
          <p class="text-small text-muted">
            Entrega em {site.delivery} · pagamento via {site.payment}, combinados no WhatsApp.
          </p>
        </div>
      </div>
      <div class="flex flex-col items-start gap-4 py-10 text-center" data-cart-empty hidden>
        <p class="text-title text-ink">Sua sacola está vazia</p>
        <p class="text-muted">Escolha o tamanho e o aroma nos modelos e toque em “Adicionar à sacola”.</p>
        <a href="#modelos" class="cart__btn cart__btn--primary w-full" data-cart-close>
          Ver os modelos
        </a>
      </div>
    </section>

    <!-- 2. Entrega -->
    <section class="cart__body" data-step="1" aria-label="Dados para a entrega" hidden>
      <form class="flex flex-col gap-4" data-cart-form novalidate>
        <p class="text-small text-muted">
          Entregamos em {site.delivery}. Preencha os dados para a entrega (complemento e observações são opcionais); o
          dia e a taxa de entrega a gente combina com você no WhatsApp.
        </p>
        <label class="cart__field">
          <span>
            Seu nome{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <input
            name="name"
            autocomplete="name"
            required
            minlength="2"
            placeholder="Como podemos te chamar?"
            aria-describedby="erro-name"
          />
          <small class="cart__error" id="erro-name" hidden>
            Conta pra gente o seu nome.
          </small>
        </label>
        <div class="cart__field">
          <label for="cart-cep">
            CEP{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </label>
          <div class="cart__cep">
            <input
              id="cart-cep"
              name="cep"
              inputmode="numeric"
              autocomplete="postal-code"
              required
              minlength="9"
              maxlength="9"
              placeholder="00000-000"
              aria-describedby="cep-status erro-cep"
              data-cep
            />
            <span class="cart__cep-spin" aria-hidden="true" data-cep-spin hidden></span>
          </div>
          <small class="cart__hint" id="cep-status" aria-live="polite" data-cep-status>
            Digite o CEP e a gente preenche o endereço.
            <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" rel="noopener">
              Não sei meu CEP
            </a>
          </small>
          <small class="cart__error" id="erro-cep" hidden>
            Informe um CEP com 8 números.
          </small>
        </div>
        <label class="cart__field">
          <span>
            Rua{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <input name="address" autocomplete="address-line1" required minlength="3" aria-describedby="erro-address" />
          <small class="cart__error" id="erro-address" hidden>
            Informe a rua.
          </small>
        </label>
        <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-3">
          <label class="cart__field">
            <span>
              Número{' '}
              <span class="text-bordo" aria-hidden="true">
                *
              </span>
            </span>
            <input
              name="number"
              inputmode="numeric"
              autocomplete="off"
              required
              minlength="1"
              aria-describedby="erro-number"
              data-number
            />
            <small class="cart__error" id="erro-number" hidden>
              Informe o número.
            </small>
          </label>
          <label class="cart__field">
            <span>
              Complemento <em class="font-normal text-muted not-italic">(opcional)</em>
            </span>
            <input name="complement" autocomplete="address-line2" placeholder="Ap., bloco" />
          </label>
        </div>
        <label class="cart__field">
          <span>
            Bairro{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <input
            name="district"
            autocomplete="address-level3"
            required
            minlength="2"
            aria-describedby="erro-district"
          />
          <small class="cart__error" id="erro-district" hidden>
            Informe o bairro.
          </small>
        </label>
        <label class="cart__field">
          <span>
            Cidade{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <select name="city" autocomplete="address-level2" required aria-describedby="erro-city">
            <option value="">Escolha a cidade</option>
            {site.areaServed.map((c) => (
              <option value={c}>{c}</option>
            ))}
            <option value="Outra cidade">Outra cidade</option>
          </select>
          <small class="cart__error" id="erro-city" hidden>
            Escolha a cidade da entrega.
          </small>
        </label>
        <label class="cart__field">
          <span>
            Observações <em class="font-normal text-muted not-italic">(opcional)</em>
          </span>
          <textarea name="notes" rows="3" placeholder="É presente? Quer um bilhete? Conte pra gente."></textarea>
        </label>
        <p class="text-small text-muted">
          <span class="text-bordo" aria-hidden="true">
            *
          </span>{' '}
          Campos obrigatórios.
        </p>
      </form>
    </section>

    <!-- 3. Revisar e enviar -->
    <section class="cart__body" data-step="2" aria-label="Revisar e enviar" hidden>
      <div class="flex flex-col gap-6">
        <div class="ticket">
          <div class="flex flex-col gap-4">
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-col">
                <p class="text-label uppercase text-bordo">Resumo do pedido</p>
                <p class="text-small text-muted" data-ticket-date></p>
              </div>
              <img src="/brand/logo.svg" alt="" width="50" height="40" class="h-10 w-auto" />
            </div>
            <hr class="ticket__rule" />
            <ul class="flex flex-col gap-3 text-small text-ink" data-cart-summary></ul>
            <hr class="ticket__rule" />
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-semibold text-ink">
                Total <span class="text-small font-normal text-muted">(sem a entrega)</span>
              </span>
              <span class="text-title text-ink" data-cart-total-review></span>
            </div>
            <p class="text-small text-muted" data-cart-where></p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-label uppercase text-muted">Próximos passos</p>
          <ol class="flex flex-col gap-3">
            <li class="cart__next">
              <span>1</span>Você envia o pedido pelo WhatsApp (a mensagem já vai pronta).
            </li>
            <li class="cart__next">
              <span>2</span>A gente confirma os aromas, o prazo e o valor da entrega.
            </li>
            <li class="cart__next">
              <span>3</span>Você paga via {site.payment} e a gente produz as suas velas à mão.
            </li>
            <li class="cart__next">
              <span>4</span>Entregamos em {site.delivery}, prontas para acender ou presentear.
            </li>
          </ol>
        </div>
      </div>
    </section>

    <footer class="cart__footer flex flex-col gap-2 border-t border-line bg-white px-6 pt-4" data-cart-footer>
      <div class="flex gap-3">
        <button type="button" class="cart__btn cart__btn--ghost" data-cart-back hidden>
          Voltar
        </button>
        <button type="button" class="cart__btn cart__btn--primary flex-1" data-cart-next>
          <span data-cart-next-label>Continuar</span>
        </button>
        <a href="#" target="_blank" rel="noopener" class="cart__btn cart__btn--primary flex-1" data-cart-send hidden>
          Enviar pelo WhatsApp<span class="sr-only"> (abre o WhatsApp)</span>
        </a>
      </div>
      <button type="button" class="cart__clear self-center" data-cart-clear>
        <span data-cart-clear-label>Esvaziar sacola</span>
      </button>
    </footer>
  </div>
</dialog>

<style>
  .cart {
    margin: 0 0 0 auto;
    /* largura com limites: mín. 400px e máx. 560px (nunca maior que a tela); no celular, tela inteira */
    width: min(100vw, clamp(400px, 44vw, 560px));
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-creme);
    color: var(--color-ink);
  }
  /* Aviso ao adicionar: cartão claro, entra deslizando de leve abaixo do menu e some sozinho. */
  .cart-toast {
    position: fixed;
    top: 72px;
    right: 16px;
    left: 16px;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    border-radius: 16px;
    background: var(--color-white);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      0 16px 32px -16px rgb(42 20 24 / 0.35);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.35s var(--ease-out-soft),
      transform 0.5s var(--ease-out-soft);
  }
  .cart-toast.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (width >= 40rem) {
    .cart-toast {
      left: auto;
      width: 360px;
      right: max(16px, calc((100vw - 1200px) / 2));
    }
  }
  /* Ticket (comanda): papel branco, linhas tracejadas e serrilhado embaixo. */
  .ticket {
    position: relative;
    margin-bottom: 16px;
    padding: 24px 24px 32px;
    border-radius: 24px 24px 0 0;
    background: var(--color-white);
    box-shadow: 0 16px 32px -24px rgb(42 20 24 / 0.35);
  }
  .ticket::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -12px;
    height: 12px;
    background:
      linear-gradient(135deg, var(--color-white) 8px, transparent 0) 0 0 / 16px 12px repeat-x,
      linear-gradient(225deg, var(--color-white) 8px, transparent 0) 0 0 / 16px 12px repeat-x;
  }
  .ticket__rule {
    border: 0;
    border-top: 1.5px dashed var(--color-line);
  }
  .cart::backdrop {
    background: rgb(42 20 24 / 0.45);
  }
  .cart__panel {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px 24px;
  }
  .cart__step {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .cart__step-n {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 12px;
    font-weight: 600;
  }
  .cart__step.is-current {
    color: var(--color-bordo);
    font-weight: 600;
  }
  .cart__step.is-current .cart__step-n,
  .cart__step.is-done .cart__step-n {
    background: var(--color-bordo);
    color: var(--color-white);
    box-shadow: none;
  }
  .cart__progress {
    height: 2px;
    border-radius: 999px;
    background: var(--color-line);
    overflow: hidden;
  }
  .cart__progress > span {
    display: block;
    height: 100%;
    width: calc(100% / 3);
    border-radius: inherit;
    background: var(--color-bordo);
    transition: width 0.4s var(--ease-out-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .cart__progress > span {
      transition: none;
    }
  }
  /* Botões principais: 64px de altura (grid de 8, alvo de toque bem acima dos 44px), texto 17px, sem ícone. */
  .cart__btn {
    display: inline-flex;
    white-space: nowrap;
    min-height: 64px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 32px;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.2px;
    line-height: 1;
    transition:
      background-color 0.2s,
      box-shadow 0.25s var(--ease-out-soft),
      transform 0.15s var(--ease-out-soft);
  }
  .cart__btn:focus-visible {
    outline: 3px solid var(--color-bordo);
    outline-offset: 3px;
  }
  .cart__btn:active {
    transform: scale(0.98);
  }
  .cart__btn--primary {
    background: var(--color-bordo);
    color: var(--color-white);
    box-shadow: 0 10px 24px -12px rgb(107 30 46 / 0.6);
  }
  .cart__btn--primary:hover {
    background: var(--color-bordo-dark);
    box-shadow: 0 14px 28px -12px rgb(74 18 31 / 0.65);
  }
  .cart__btn--ghost {
    padding: 0 24px;
    color: var(--color-bordo);
    background: var(--color-white);
    box-shadow: inset 0 0 0 1.5px var(--color-line);
  }
  .cart__btn--ghost:hover {
    background: var(--color-rosa-soft);
    box-shadow: inset 0 0 0 1.5px var(--color-bordo);
  }
  .cart__footer {
    padding-bottom: max(12px, env(safe-area-inset-bottom));
  }
  /* Fechar: pílula de 48px. */
  .cart__close {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--color-bordo);
    font-weight: 600;
    font-size: var(--text-small);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: background-color 0.2s;
  }
  .cart__close:hover {
    background: var(--color-rosa-soft);
  }
  /* Esvaziar: ação destrutiva e secundária, 48px de altura; pede um segundo toque para confirmar. */
  .cart__clear {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .cart__clear:hover {
    color: var(--color-bordo);
    background: var(--color-rosa-soft);
  }
  .cart__clear.is-confirm {
    color: var(--color-erro);
    background: rgb(213 0 0 / 0.08);
  }
  .cart__link {
    color: var(--color-bordo);
    font-weight: 600;
    transition: color 0.2s;
  }
  .cart__link:hover {
    color: var(--color-bordo-dark);
  }
  .cart__cep {
    position: relative;
  }
  .cart__cep input {
    width: 100%;
    padding-right: 48px;
  }
  .cart__cep-spin {
    position: absolute;
    top: 50%;
    right: 16px;
    width: 20px;
    height: 20px;
    margin-top: -10px;
    border-radius: 999px;
    border: 2px solid var(--color-line);
    border-top-color: var(--color-bordo);
    animation: cep-spin 0.7s linear infinite;
  }
  @keyframes cep-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .cart__hint {
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 400;
  }
  .cart__hint a {
    color: var(--color-bordo);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cart__hint.is-ok {
    color: var(--color-bordo);
    font-weight: 600;
  }
  .cart__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .cart__field input,
  .cart__field select,
  .cart__field textarea {
    min-height: 48px;
    border-radius: 16px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-line);
    padding: 12px 16px;
    font: inherit;
    font-weight: 400;
    font-size: 16px; /* evita o zoom automático do iOS */
    color: var(--color-ink);
  }
  .cart__next {
    display: flex;
    gap: 12px;
    font-size: var(--text-small);
  }
  .cart__next span {
    display: grid;
    flex: none;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-rosa);
    color: var(--color-bordo);
    font-size: 12px;
    font-weight: 600;
  }
  .cart__error {
    color: var(--color-erro);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .cart__field [aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--color-erro);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cart[open] {
      animation: cart-in 0.35s var(--ease-out-soft);
    }
    .cart[open]::backdrop {
      animation: cart-fade 0.35s ease;
    }
    @keyframes cart-in {
      from {
        transform: translateX(32px);
        opacity: 0;
      }
    }
    @keyframes cart-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

<!-- Itens da sacola são criados por JS (innerHTML) e não recebem o atributo de escopo do Astro:
     por isso estas regras são globais, presas ao .cart. -->
<style is:global>
  /* Quantidade: pílula de 56px com botões de 48px (grid de 8, acima do mínimo de toque de 44px). */
  .cart .cart__qty {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .cart .cart__qty button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--color-rosa-soft);
    color: var(--color-bordo);
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.15s;
  }
  @media (hover: hover) {
    .cart .cart__qty button:hover:not(:disabled) {
      background: var(--color-bordo);
      color: var(--color-white);
    }
  }
  .cart .cart__qty button:active:not(:disabled) {
    transform: scale(0.9);
  }
  .cart .cart__qty button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .cart .cart__qty button:focus-visible,
  .cart .cart__remove:focus-visible {
    outline: 2px solid var(--color-bordo);
    outline-offset: 2px;
  }
  .cart .cart__qty output {
    min-width: 40px;
    text-align: center;
    font-size: 1.0625rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }
  /* Remover: pílula de 48px, discreta. */
  .cart .cart__remove {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .cart .cart__remove:hover {
    color: var(--color-bordo);
    background: var(--color-rosa-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cart .cart__qty output.is-pop {
      animation: qty-pop 0.35s var(--ease-out-soft);
    }
    @keyframes qty-pop {
      40% {
        transform: scale(1.25);
        color: var(--color-bordo);
      }
    }
  }
</style>

<script>
  import {
    brl,
    clear,
    count,
    getCustomer,
    getItems,
    orderMessage,
    setCustomer,
    setQty,
    total,
    track,
  } from '../../scripts/cart';
  import { site } from '../../config/site';

  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-cart]');
  if (dialog) {
    const $ = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const list = $<HTMLUListElement>('[data-cart-list]');
    const empty = $<HTMLElement>('[data-cart-empty]');
    const totalEl = $<HTMLElement>('[data-cart-total]');
    const next = $<HTMLButtonElement>('[data-cart-next]');
    const back = $<HTMLButtonElement>('[data-cart-back]');
    const send = $<HTMLAnchorElement>('[data-cart-send]');
    const clearBtn = $<HTMLButtonElement>('[data-cart-clear]');
    const footer = $<HTMLElement>('[data-cart-footer]');
    const form = $<HTMLFormElement>('[data-cart-form]');
    const summary = $<HTMLUListElement>('[data-cart-summary]');
    const where = $<HTMLElement>('[data-cart-where]');
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-step]')];
    const tabs = [...dialog.querySelectorAll<HTMLElement>('[data-step-tab]')];
    const progress = dialog.querySelector<HTMLElement>('[data-cart-progress]');
    const svg = (d: string, size = 20) =>
      `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="${d}" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    const ICON_MINUS = svg('M5 12h14');
    const ICON_PLUS = svg('M12 5v14M5 12h14');
    const nextLabel = $<HTMLElement>('[data-cart-next-label]');
    const clearLabel = $<HTMLElement>('[data-cart-clear-label]');
    let step = 0;
    let lastChanged = '';

    const renderList = () => {
      const items = getItems();
      list.replaceChildren(
        ...items.map((i) => {
          const li = document.createElement('li');
          li.className = 'flex flex-col gap-3 py-4';
          // Quantidade e Remover numa linha própria, com a largura toda do item: no celular não cabem
          // ao lado da foto. Em telas largas a linha alinha com o texto (64px da foto + 16px de espaço).
          li.innerHTML = `
            <div class="flex gap-4">
              <img src="${i.thumb}" alt="" width="64" height="64" class="size-16 flex-none rounded-lg object-cover ring-1 ring-line" />
              <div class="flex min-w-0 flex-1 flex-col gap-1">
                <div class="flex justify-between gap-2">
                  <p class="font-semibold text-ink">${i.title}</p>
                  <p class="flex-none font-semibold text-ink">${brl(i.unit * i.qty)}</p>
                </div>
                ${i.detail ? `<p class="text-small text-muted">${i.detail}</p>` : ''}
              </div>
            </div>
            <div class="flex items-center justify-between gap-2 lg:pl-20">
              <div class="cart__qty" role="group" aria-label="Quantidade de ${i.title}${i.detail ? `, ${i.detail}` : ''}">
                <button type="button" data-dec aria-label="Tirar uma" ${i.qty <= 1 ? 'disabled' : ''}>${ICON_MINUS}</button>
                <output aria-live="polite" class="${i.key === lastChanged ? 'is-pop' : ''}">${i.qty}</output>
                <button type="button" data-inc aria-label="Adicionar mais uma">${ICON_PLUS}</button>
              </div>
              <button type="button" class="cart__remove" data-remove aria-label="Remover ${i.title}${i.detail ? `, ${i.detail}` : ''}">Remover</button>
            </div>`;
          li.querySelector('[data-dec]')!.addEventListener('click', () => {
            lastChanged = i.key;
            setQty(i.key, Math.max(1, i.qty - 1));
          });
          li.querySelector('[data-inc]')!.addEventListener('click', () => {
            lastChanged = i.key;
            setQty(i.key, i.qty + 1);
          });
          li.querySelector('[data-remove]')!.addEventListener('click', () => setQty(i.key, 0));
          return li;
        }),
      );
      empty.hidden = items.length > 0;
      dialog.querySelector<HTMLElement>('[data-ticket]')!.hidden = items.length === 0;
      footer.hidden = items.length === 0;
      totalEl.textContent = brl(total());
      // devolve o foco ao botão clicado depois de redesenhar a lista
      if (lastChanged) {
        const row = [...list.children].find((li) => li.querySelector('output')?.classList.contains('is-pop'));
        (row?.querySelector<HTMLButtonElement>('[data-inc]') ?? null)?.focus({ preventScroll: true });
        lastChanged = '';
      }
    };

    const today = new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
    dialog.querySelectorAll<HTMLElement>('[data-ticket-date]').forEach((el) => (el.textContent = today));

    const renderReview = () => {
      dialog.querySelector<HTMLElement>('[data-cart-total-review]')!.textContent = brl(total());
      summary.replaceChildren(
        ...getItems().map((i) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-3';
          li.innerHTML = `<img src="${i.thumb}" alt="" width="40" height="40" class="size-10 flex-none rounded-lg object-cover ring-1 ring-line" /><span class="min-w-0 flex-1"><span class="font-semibold">${i.qty}× ${i.title}</span>${i.detail ? `<span class="block text-muted">${i.detail}</span>` : ''}</span><span class="flex-none font-semibold">${brl(i.unit * i.qty)}</span>`;
          return li;
        }),
      );
      const c = getCustomer();
      const place = [
        [c.address, c.number].filter((v) => v.trim()).join(', '),
        c.complement,
        c.district,
        c.city,
        c.cep && `CEP ${c.cep}`,
      ]
        .filter((v) => v && v.trim())
        .join(', ');
      where.textContent =
        [c.name && `Para ${c.name}`, place && `entrega em ${place}`].filter(Boolean).join(' · ') ||
        'Sem dados de entrega: a gente combina no WhatsApp.';
      send.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(orderMessage())}`;
    };

    // campos obrigatórios: marca os que faltam, mostra a mensagem e leva o foco ao primeiro
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    const isValid = (el: HTMLInputElement | HTMLSelectElement) =>
      el.value.trim().length >= Number(el.getAttribute('minlength') ?? 1);
    const showError = (el: HTMLInputElement | HTMLSelectElement, on: boolean) => {
      el.setAttribute('aria-invalid', String(on));
      const msg = dialog.querySelector<HTMLElement>(`#erro-${el.name}`);
      if (msg) msg.hidden = !on;
    };
    const validate = () => {
      const bad = fields.filter((el) => !isValid(el));
      fields.forEach((el) => showError(el, bad.includes(el)));
      bad[0]?.focus();
      return bad.length === 0;
    };
    fields.forEach((el) => el.addEventListener('blur', () => el.value && showError(el, !isValid(el))));
    fields.forEach((el) =>
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && showError(el, !isValid(el))),
    );

    const go = (n: number) => {
      // do passo 3 em diante só com os dados completos
      if (n >= 2 && !fields.every(isValid)) {
        if (step !== 1) go(1);
        validate();
        return;
      }
      step = Math.max(0, Math.min(2, n));
      if (getItems().length === 0) step = 0;
      panels.forEach((p, i) => (p.hidden = i !== step));
      if (progress) progress.style.width = `${((step + 1) / 3) * 100}%`;
      tabs.forEach((t, i) => {
        t.classList.toggle('is-current', i === step);
        t.classList.toggle('is-done', i < step);
        if (i === step) t.setAttribute('aria-current', 'step');
        else t.removeAttribute('aria-current');
      });
      back.hidden = step === 0;
      next.hidden = step === 2;
      send.hidden = step !== 2;
      clearBtn.hidden = step !== 0;
      nextLabel.textContent = step === 0 ? 'Continuar' : 'Revisar pedido';
      if (step === 2) renderReview();
      if (step === 1) track('begin_checkout', { value: total(), items: count() });
      if (step !== 1)
        panels[step].querySelector<HTMLElement>('input, select, textarea, button')?.focus({ preventScroll: true });
    };

    // dados de entrega: preenche e salva enquanto digita
    const c = getCustomer();
    for (const [k, v] of Object.entries(c)) {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (el) el.value = v;
    }
    form.addEventListener('input', () => {
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      setCustomer(data);
    });
    // CEP: máscara 00000-000 e busca do endereço (ViaCEP, com BrasilAPI de reserva).
    const cepInput = $<HTMLInputElement>('[data-cep]');
    const cepStatus = $<HTMLElement>('[data-cep-status]');
    const cepSpin = $<HTMLElement>('[data-cep-spin]');
    const cepHint = cepStatus.innerHTML;
    const citySelect = form.elements.namedItem('city') as HTMLSelectElement;
    const setField = (name: string, value: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (!el || !value) return;
      el.value = value;
      showError(el, false);
    };
    type Endereco = { street: string; district: string; city: string; uf: string };
    const withTimeout = (url: string, ms = 5000) => {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), ms);
      return fetch(url, { signal: ctrl.signal }).finally(() => clearTimeout(t));
    };
    const lookup = async (cep: string): Promise<Endereco | null | 'erro'> => {
      try {
        const r = await withTimeout(`https://viacep.com.br/ws/${cep}/json/`);
        const d = await r.json();
        if (d.erro) return null;
        return { street: d.logradouro, district: d.bairro, city: d.localidade, uf: d.uf };
      } catch {
        try {
          const r = await withTimeout(`https://brasilapi.com.br/api/cep/v1/${cep}`);
          if (r.status === 404) return null;
          const d = await r.json();
          return { street: d.street, district: d.neighborhood, city: d.city, uf: d.state };
        } catch {
          return 'erro';
        }
      }
    };
    let lastCep = '';
    const say = (html: string, ok = false) => {
      cepStatus.innerHTML = html;
      cepStatus.classList.toggle('is-ok', ok);
    };
    cepInput.addEventListener('input', async () => {
      const digits = cepInput.value.replace(/\D/g, '').slice(0, 8);
      cepInput.value = digits.length > 5 ? `${digits.slice(0, 5)}-${digits.slice(5)}` : digits;
      if (digits.length < 8) {
        if (lastCep) say(cepHint);
        lastCep = '';
        return;
      }
      if (digits === lastCep) return;
      lastCep = digits;
      showError(cepInput, false);
      cepSpin.hidden = false;
      say('Buscando o endereço…');
      const res = await lookup(digits);
      if (digits !== lastCep) return; // o CEP mudou enquanto buscava
      cepSpin.hidden = true;
      if (res === 'erro') {
        say('Não conseguimos buscar o CEP agora. Preencha o endereço abaixo.');
        return;
      }
      if (!res) {
        say('CEP não encontrado. Confira os números ou preencha o endereço abaixo.');
        return;
      }
      setField('address', res.street);
      setField('district', res.district);
      const served = [...citySelect.options].some((o) => o.value === res.city);
      citySelect.value = served ? res.city : 'Outra cidade';
      showError(citySelect, false);
      say(
        served
          ? `Endereço encontrado em ${res.city}. Agora é só o número.`
          : `Esse CEP é de ${res.city}/${res.uf}, fora da nossa área de entrega. Pode seguir que a gente combina no WhatsApp.`,
        served,
      );
      form.dispatchEvent(new Event('input')); // salva os dados preenchidos
      // CEP de rua única: vai direto ao número. CEP geral de cidade (sem rua): vai para a rua.
      const nextField = form.elements.namedItem(res.street ? 'number' : 'address') as HTMLInputElement;
      nextField.focus();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      go(2);
    });

    next.addEventListener('click', () => go(step + 1));
    back.addEventListener('click', () => go(step - 1));
    // Esvaziar pede confirmação: o primeiro toque arma, o segundo (em até 3 s) esvazia.
    let armed = 0;
    const disarm = () => {
      clearTimeout(armed);
      armed = 0;
      clearBtn.classList.remove('is-confirm');
      clearLabel.textContent = 'Esvaziar sacola';
    };
    clearBtn.addEventListener('click', () => {
      if (armed) {
        disarm();
        clear();
        return;
      }
      clearBtn.classList.add('is-confirm');
      clearLabel.textContent = 'Toque de novo para esvaziar';
      armed = window.setTimeout(disarm, 3000);
    });
    send.addEventListener('click', (e) => {
      if (!fields.every(isValid)) {
        e.preventDefault();
        go(2);
        return;
      }
      track('send_order', { value: total(), items: count() });
    });

    const open = () => {
      renderList();
      go(0);
      if (!dialog.open) dialog.showModal();
    };
    const close = () => dialog.close();
    document.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('[data-open-cart]')) {
        e.preventDefault();
        open();
      } else if (t.closest('[data-cart-close]')) close();
    });
    // clique no fundo escuro fecha
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    window.addEventListener('cart:change', () => {
      renderList();
      if (getItems().length === 0) go(0);
    });
    window.addEventListener('cart:open', open);

    // aviso rápido ao adicionar (some sozinho)
    const toast = document.querySelector<HTMLElement>('[data-cart-toast]')!;
    const toastText = document.querySelector<HTMLElement>('[data-cart-toast-text]')!;
    const toastImg = document.querySelector<HTMLImageElement>('[data-cart-toast-img]')!;
    const toastCount = document.querySelector<HTMLElement>('[data-cart-toast-count]')!;
    let timer = 0;
    window.addEventListener('cart:added', (e) => {
      const d = (e as CustomEvent<{ title: string; detail: string; thumb: string; count: number }>).detail;
      toastText.textContent = `${d.title}${d.detail ? ` · ${d.detail}` : ''}`;
      if (d.thumb) toastImg.src = d.thumb;
      toastImg.hidden = !d.thumb;
      toastCount.textContent = String(d.count);
      toast.classList.add('is-on');
      clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove('is-on'), 3200);
    });
    toast.addEventListener('click', () => toast.classList.remove('is-on'));
    renderList();
  }
</script>
