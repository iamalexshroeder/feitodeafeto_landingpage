---
// Sacola: painel lateral (<dialog>) em 3 passos — 1. Sacola, 2. Entrega, 3. Revisar e enviar.
// O pedido sai como mensagem pronta no WhatsApp; pagamento (Pix) e entrega são combinados na conversa.
// Abre por qualquer elemento com [data-open-cart]. Sem JS, nada disso aparece (os botões diretos de
// WhatsApp continuam funcionando).
import { site } from '../../config/site';

const steps = ['Sacola', 'Entrega', 'Enviar'];
---

<div class="cart-toast" role="status" aria-live="polite" data-cart-toast>
  <img
    src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
    alt=""
    width="48"
    height="48"
    class="size-12 flex-none rounded-lg object-cover"
    data-cart-toast-img
  />
  <div class="flex min-w-0 flex-col">
    <span class="text-small font-semibold text-ink">Adicionado à sacola</span>
    <span class="truncate text-small text-muted" data-cart-toast-text></span>
  </div>
  <button
    type="button"
    class="ml-auto flex-none text-small font-semibold text-bordo underline underline-offset-4"
    data-open-cart
  >
    Ver sacola (<span data-cart-toast-count>0</span>)
  </button>
</div>

<dialog class="cart" aria-labelledby="sacola-titulo" data-cart>
  <div class="cart__panel">
    <header class="flex items-center justify-between gap-4 border-b border-line px-6 py-4">
      <h2 id="sacola-titulo" class="text-title text-ink">
        Sua sacola
      </h2>
      <button type="button" class="cart__link" data-cart-close>
        Fechar
      </button>
    </header>

    <ol class="flex gap-2 px-6 pt-4" aria-label="Etapas do pedido" data-cart-steps>
      {steps.map((label, i) => (
        <li class="cart__step" data-step-tab={i}>
          <span class="cart__step-n" aria-hidden="true">
            {i + 1}
          </span>
          {label}
        </li>
      ))}
    </ol>

    <!-- 1. Sacola -->
    <section class="cart__body" data-step="0" aria-label="Itens da sacola">
      <div class="ticket" data-ticket>
        <div class="flex flex-col gap-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col">
              <p class="text-label uppercase text-bordo">Seu pedido</p>
              <p class="text-small text-muted" data-ticket-date></p>
            </div>
            <div class="ticket-slices" data-ticket-thumbs aria-hidden="true"></div>
          </div>
          <hr class="ticket__rule" />
          <ul class="flex flex-col divide-y divide-dashed divide-line" data-cart-list></ul>
          <hr class="ticket__rule" />
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-semibold text-ink">
              Total <span class="text-small font-normal text-muted">(sem a entrega)</span>
            </span>
            <span class="text-title text-ink" data-cart-total aria-live="polite">
              R$ 0,00
            </span>
          </div>
          <p class="text-small text-muted">
            Entrega em {site.delivery} · pagamento via {site.payment}, combinados no WhatsApp.
          </p>
        </div>
      </div>
      <div class="flex flex-col items-start gap-4 py-10 text-center" data-cart-empty hidden>
        <p class="text-title text-ink">Sua sacola está vazia</p>
        <p class="text-muted">Escolha o tamanho e o aroma nos modelos e toque em “Adicionar à sacola”.</p>
        <a href="#modelos" class="cart__btn cart__btn--primary w-full" data-cart-close>
          Ver os modelos
        </a>
      </div>
    </section>

    <!-- 2. Entrega -->
    <section class="cart__body" data-step="1" aria-label="Dados para a entrega" hidden>
      <form class="flex flex-col gap-4" data-cart-form novalidate>
        <p class="text-small text-muted">
          Entregamos em {site.delivery}. Preencha os dados para a entrega (só as observações são opcionais); o dia e a
          taxa de entrega a gente combina com você no WhatsApp.
        </p>
        <label class="cart__field">
          <span>
            Seu nome{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <input
            name="name"
            autocomplete="name"
            required
            minlength="2"
            placeholder="Como podemos te chamar?"
            aria-describedby="erro-name"
          />
          <small class="cart__error" id="erro-name" hidden>
            Conta pra gente o seu nome.
          </small>
        </label>
        <label class="cart__field">
          <span>
            Cidade{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <select name="city" autocomplete="address-level2" required aria-describedby="erro-city">
            <option value="">Escolha a cidade</option>
            {site.areaServed.map((c) => (
              <option value={c}>{c}</option>
            ))}
            <option value="Outra cidade">Outra cidade</option>
          </select>
          <small class="cart__error" id="erro-city" hidden>
            Escolha a cidade da entrega.
          </small>
        </label>
        <label class="cart__field">
          <span>
            Bairro{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <input
            name="district"
            autocomplete="address-level3"
            required
            minlength="2"
            aria-describedby="erro-district"
          />
          <small class="cart__error" id="erro-district" hidden>
            Informe o bairro.
          </small>
        </label>
        <label class="cart__field">
          <span>
            Rua e número{' '}
            <span class="text-bordo" aria-hidden="true">
              *
            </span>
          </span>
          <input
            name="address"
            autocomplete="street-address"
            required
            minlength="4"
            placeholder="Ex.: Rua das Flores, 120, ap. 32"
            aria-describedby="erro-address"
          />
          <small class="cart__error" id="erro-address" hidden>
            Informe a rua e o número.
          </small>
        </label>
        <label class="cart__field">
          <span>
            Observações <em class="font-normal text-muted not-italic">(opcional)</em>
          </span>
          <textarea name="notes" rows="3" placeholder="É presente? Quer um bilhete? Conte pra gente."></textarea>
        </label>
        <p class="text-small text-muted">
          <span class="text-bordo" aria-hidden="true">
            *
          </span>{' '}
          Campos obrigatórios.
        </p>
      </form>
    </section>

    <!-- 3. Revisar e enviar -->
    <section class="cart__body" data-step="2" aria-label="Revisar e enviar" hidden>
      <div class="flex flex-col gap-6">
        <div class="ticket">
          <div class="flex flex-col gap-4">
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-col">
                <p class="text-label uppercase text-bordo">Resumo do pedido</p>
                <p class="text-small text-muted" data-ticket-date></p>
              </div>
              <div class="ticket-slices" data-ticket-thumbs aria-hidden="true"></div>
            </div>
            <hr class="ticket__rule" />
            <ul class="flex flex-col gap-3 text-small text-ink" data-cart-summary></ul>
            <hr class="ticket__rule" />
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-semibold text-ink">
                Total <span class="text-small font-normal text-muted">(sem a entrega)</span>
              </span>
              <span class="text-title text-ink" data-cart-total-review></span>
            </div>
            <p class="text-small text-muted" data-cart-where></p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-label uppercase text-muted">Próximos passos</p>
          <ol class="flex flex-col gap-3">
            <li class="cart__next">
              <span>1</span>Você envia o pedido pelo WhatsApp (a mensagem já vai pronta).
            </li>
            <li class="cart__next">
              <span>2</span>A gente confirma os aromas, o prazo e o valor da entrega.
            </li>
            <li class="cart__next">
              <span>3</span>Você paga via {site.payment} e a gente produz as suas velas à mão.
            </li>
            <li class="cart__next">
              <span>4</span>Entregamos em {site.delivery}, prontas para acender ou presentear.
            </li>
          </ol>
        </div>
      </div>
    </section>

    <footer class="flex flex-col gap-3 border-t border-line bg-white px-6 py-4" data-cart-footer>
      <div class="flex gap-2">
        <button type="button" class="cart__btn cart__btn--ghost" data-cart-back hidden>
          Voltar
        </button>
        <button type="button" class="cart__btn cart__btn--primary flex-1" data-cart-next>
          Continuar
        </button>
        <a href="#" target="_blank" rel="noopener" class="cart__btn cart__btn--primary flex-1" data-cart-send hidden>
          Enviar pelo WhatsApp<span class="sr-only"> (abre o WhatsApp)</span>
        </a>
      </div>
      <button type="button" class="cart__link self-center text-small" data-cart-clear>
        Esvaziar sacola
      </button>
    </footer>
  </div>
</dialog>

<style>
  .cart {
    margin: 0 0 0 auto;
    /* largura com limites: mín. 400px e máx. 560px (nunca maior que a tela); no celular, tela inteira */
    width: min(100vw, clamp(400px, 44vw, 560px));
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-creme);
    color: var(--color-ink);
  }
  /* Aviso ao adicionar: cartão claro, entra deslizando de leve abaixo do menu e some sozinho. */
  .cart-toast {
    position: fixed;
    top: 72px;
    right: 16px;
    left: 16px;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    border-radius: 16px;
    background: var(--color-white);
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      0 16px 32px -16px rgb(42 20 24 / 0.35);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity 0.35s var(--ease-out-soft),
      transform 0.5s var(--ease-out-soft);
  }
  .cart-toast.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (width >= 40rem) {
    .cart-toast {
      left: auto;
      width: 360px;
      right: max(16px, calc((100vw - 1200px) / 2));
    }
  }
  /* Ticket (comanda): papel branco, linhas tracejadas e serrilhado embaixo. */
  .ticket {
    position: relative;
    margin-bottom: 16px;
    padding: 24px 24px 32px;
    border-radius: 24px 24px 0 0;
    background: var(--color-white);
    box-shadow: 0 16px 32px -24px rgb(42 20 24 / 0.35);
  }
  .ticket::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -12px;
    height: 12px;
    background:
      linear-gradient(135deg, var(--color-white) 8px, transparent 0) 0 0 / 16px 12px repeat-x,
      linear-gradient(225deg, var(--color-white) 8px, transparent 0) 0 0 / 16px 12px repeat-x;
  }
  .ticket__rule {
    border: 0;
    border-top: 1.5px dashed var(--color-line);
  }
  .cart::backdrop {
    background: rgb(42 20 24 / 0.45);
  }
  .cart__panel {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cart__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px 24px;
  }
  .cart__step {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 2px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .cart__step-n {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: 12px;
    font-weight: 600;
  }
  .cart__step.is-current {
    border-color: var(--color-bordo);
    color: var(--color-bordo);
    font-weight: 600;
  }
  .cart__step.is-current .cart__step-n,
  .cart__step.is-done .cart__step-n {
    background: var(--color-bordo);
    color: var(--color-white);
    box-shadow: none;
  }
  .cart__step.is-done {
    border-color: var(--color-bordo);
  }
  .cart__btn {
    display: inline-flex;
    white-space: nowrap;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 24px;
    font-weight: 600;
    line-height: 1;
    transition: background-color 0.2s;
  }
  .cart__btn--primary {
    background: var(--color-bordo);
    color: var(--color-white);
  }
  .cart__btn--primary:hover {
    background: var(--color-bordo-dark);
  }
  .cart__btn--ghost {
    color: var(--color-bordo);
    box-shadow: inset 0 0 0 1.5px var(--color-bordo);
  }
  .cart__link {
    color: var(--color-bordo);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cart__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .cart__field input,
  .cart__field select,
  .cart__field textarea {
    min-height: 48px;
    border-radius: 16px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-line);
    padding: 12px 16px;
    font: inherit;
    font-weight: 400;
    font-size: 16px; /* evita o zoom automático do iOS */
    color: var(--color-ink);
  }
  .cart__next {
    display: flex;
    gap: 12px;
    font-size: var(--text-small);
  }
  .cart__next span {
    display: grid;
    flex: none;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-rosa);
    color: var(--color-bordo);
    font-size: 12px;
    font-weight: 600;
  }
  /* Mini card "fatiado": uma fatia por item (até 4), com a foto de cada um; "+n" na última se houver mais. */
  .ticket-slices {
    display: flex;
    flex: none;
    gap: 2px;
    width: 128px;
    height: 72px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-white);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  .ticket-slices > * {
    position: relative;
    flex: 1;
    min-width: 0;
  }
  .ticket-slices img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ticket-slices b {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(42 20 24 / 0.55);
    color: var(--color-white);
    font-size: 12px;
  }
  .cart__error {
    color: var(--color-bordo);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .cart__field [aria-invalid='true'] {
    box-shadow: inset 0 0 0 1.5px var(--color-bordo);
  }
  /* Seletor de quantidade: pílula com − e + em círculos, número no meio. */
  .cart__qty {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .cart__qty button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-rosa-soft);
    color: var(--color-bordo);
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.15s;
  }
  .cart__qty button:hover:not(:disabled) {
    background: var(--color-bordo);
    color: var(--color-white);
  }
  .cart__qty button:active:not(:disabled) {
    transform: scale(0.9);
  }
  .cart__qty button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .cart__qty output {
    min-width: 32px;
    text-align: center;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cart__qty output.is-pop {
      animation: qty-pop 0.35s var(--ease-out-soft);
    }
    @keyframes qty-pop {
      40% {
        transform: scale(1.25);
        color: var(--color-bordo);
      }
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cart[open] {
      animation: cart-in 0.35s var(--ease-out-soft);
    }
    .cart[open]::backdrop {
      animation: cart-fade 0.35s ease;
    }
    @keyframes cart-in {
      from {
        transform: translateX(32px);
        opacity: 0;
      }
    }
    @keyframes cart-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  import {
    brl,
    clear,
    count,
    getCustomer,
    getItems,
    orderMessage,
    setCustomer,
    setQty,
    total,
    track,
  } from '../../scripts/cart';
  import { site } from '../../config/site';

  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-cart]');
  if (dialog) {
    const $ = <T extends Element>(sel: string) => dialog.querySelector<T>(sel)!;
    const list = $<HTMLUListElement>('[data-cart-list]');
    const empty = $<HTMLElement>('[data-cart-empty]');
    const totalEl = $<HTMLElement>('[data-cart-total]');
    const next = $<HTMLButtonElement>('[data-cart-next]');
    const back = $<HTMLButtonElement>('[data-cart-back]');
    const send = $<HTMLAnchorElement>('[data-cart-send]');
    const clearBtn = $<HTMLButtonElement>('[data-cart-clear]');
    const footer = $<HTMLElement>('[data-cart-footer]');
    const form = $<HTMLFormElement>('[data-cart-form]');
    const summary = $<HTMLUListElement>('[data-cart-summary]');
    const where = $<HTMLElement>('[data-cart-where]');
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-step]')];
    const tabs = [...dialog.querySelectorAll<HTMLElement>('[data-step-tab]')];
    let step = 0;
    let lastChanged = '';

    // mini card fatiado no topo dos tickets
    const renderThumbs = () => {
      const items = getItems();
      const shown = items.slice(0, 4);
      const extra = items.length - shown.length;
      const html = shown
        .map(
          (i, n) =>
            `<span><img src="${i.thumb}" alt="" width="64" height="72" />${extra > 0 && n === shown.length - 1 ? `<b>+${extra}</b>` : ''}</span>`,
        )
        .join('');
      dialog.querySelectorAll<HTMLElement>('[data-ticket-thumbs]').forEach((el) => (el.innerHTML = html));
    };

    const renderList = () => {
      const items = getItems();
      list.replaceChildren(
        ...items.map((i) => {
          const li = document.createElement('li');
          li.className = 'flex gap-4 py-4';
          li.innerHTML = `
            <img src="${i.thumb}" alt="" width="64" height="64" class="size-16 flex-none rounded-lg object-cover ring-1 ring-line" />
            <div class="flex min-w-0 flex-1 flex-col gap-2">
              <div class="flex justify-between gap-2">
                <p class="font-semibold text-ink">${i.title}</p>
                <p class="flex-none font-semibold text-ink">${brl(i.unit * i.qty)}</p>
              </div>
              ${i.detail ? `<p class="text-small text-muted">${i.detail}</p>` : ''}
              <div class="flex items-center justify-between gap-2">
                <div class="cart__qty" role="group" aria-label="Quantidade de ${i.title}">
                  <button type="button" data-dec aria-label="Tirar uma" ${i.qty <= 1 ? 'disabled' : ''}>−</button>
                  <output aria-live="polite" class="${i.key === lastChanged ? 'is-pop' : ''}">${i.qty}</output>
                  <button type="button" data-inc aria-label="Adicionar mais uma">+</button>
                </div>
                <button type="button" class="cart__link text-small" data-remove>Remover</button>
              </div>
            </div>`;
          li.querySelector('[data-dec]')!.addEventListener('click', () => {
            lastChanged = i.key;
            setQty(i.key, Math.max(1, i.qty - 1));
          });
          li.querySelector('[data-inc]')!.addEventListener('click', () => {
            lastChanged = i.key;
            setQty(i.key, i.qty + 1);
          });
          li.querySelector('[data-remove]')!.addEventListener('click', () => setQty(i.key, 0));
          return li;
        }),
      );
      empty.hidden = items.length > 0;
      dialog.querySelector<HTMLElement>('[data-ticket]')!.hidden = items.length === 0;
      footer.hidden = items.length === 0;
      totalEl.textContent = brl(total());
      renderThumbs();
      // devolve o foco ao botão clicado depois de redesenhar a lista
      if (lastChanged) {
        const row = [...list.children].find((li) => li.querySelector('output')?.classList.contains('is-pop'));
        (row?.querySelector<HTMLButtonElement>('[data-inc]') ?? null)?.focus({ preventScroll: true });
        lastChanged = '';
      }
    };

    const today = new Date().toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
    dialog.querySelectorAll<HTMLElement>('[data-ticket-date]').forEach((el) => (el.textContent = today));

    const renderReview = () => {
      dialog.querySelector<HTMLElement>('[data-cart-total-review]')!.textContent = brl(total());
      summary.replaceChildren(
        ...getItems().map((i) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-3';
          li.innerHTML = `<img src="${i.thumb}" alt="" width="40" height="40" class="size-10 flex-none rounded-lg object-cover ring-1 ring-line" /><span class="min-w-0 flex-1"><span class="font-semibold">${i.qty}× ${i.title}</span>${i.detail ? `<span class="block text-muted">${i.detail}</span>` : ''}</span><span class="flex-none font-semibold">${brl(i.unit * i.qty)}</span>`;
          return li;
        }),
      );
      const c = getCustomer();
      const place = [c.address, c.district, c.city].filter((v) => v.trim()).join(', ');
      where.textContent =
        [c.name && `Para ${c.name}`, place && `entrega em ${place}`].filter(Boolean).join(' · ') ||
        'Sem dados de entrega: a gente combina no WhatsApp.';
      send.href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(orderMessage())}`;
    };

    // campos obrigatórios: marca os que faltam, mostra a mensagem e leva o foco ao primeiro
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
    const isValid = (el: HTMLInputElement | HTMLSelectElement) =>
      el.value.trim().length >= Number(el.getAttribute('minlength') ?? 1);
    const showError = (el: HTMLInputElement | HTMLSelectElement, on: boolean) => {
      el.setAttribute('aria-invalid', String(on));
      const msg = dialog.querySelector<HTMLElement>(`#erro-${el.name}`);
      if (msg) msg.hidden = !on;
    };
    const validate = () => {
      const bad = fields.filter((el) => !isValid(el));
      fields.forEach((el) => showError(el, bad.includes(el)));
      bad[0]?.focus();
      return bad.length === 0;
    };
    fields.forEach((el) => el.addEventListener('blur', () => el.value && showError(el, !isValid(el))));
    fields.forEach((el) =>
      el.addEventListener('input', () => el.getAttribute('aria-invalid') === 'true' && showError(el, !isValid(el))),
    );

    const go = (n: number) => {
      // do passo 3 em diante só com os dados completos
      if (n >= 2 && !fields.every(isValid)) {
        if (step !== 1) go(1);
        validate();
        return;
      }
      step = Math.max(0, Math.min(2, n));
      if (getItems().length === 0) step = 0;
      panels.forEach((p, i) => (p.hidden = i !== step));
      tabs.forEach((t, i) => {
        t.classList.toggle('is-current', i === step);
        t.classList.toggle('is-done', i < step);
        if (i === step) t.setAttribute('aria-current', 'step');
        else t.removeAttribute('aria-current');
      });
      back.hidden = step === 0;
      next.hidden = step === 2;
      send.hidden = step !== 2;
      clearBtn.hidden = step !== 0;
      next.textContent = step === 0 ? 'Continuar' : 'Revisar pedido';
      if (step === 2) renderReview();
      if (step === 1) track('begin_checkout', { value: total(), items: count() });
      if (step !== 1)
        panels[step].querySelector<HTMLElement>('input, select, textarea, button')?.focus({ preventScroll: true });
    };

    // dados de entrega: preenche e salva enquanto digita
    const c = getCustomer();
    for (const [k, v] of Object.entries(c)) {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (el) el.value = v;
    }
    form.addEventListener('input', () => {
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      setCustomer(data);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      go(2);
    });

    next.addEventListener('click', () => go(step + 1));
    back.addEventListener('click', () => go(step - 1));
    clearBtn.addEventListener('click', () => clear());
    send.addEventListener('click', (e) => {
      if (!fields.every(isValid)) {
        e.preventDefault();
        go(2);
        return;
      }
      track('send_order', { value: total(), items: count() });
    });

    const open = () => {
      renderList();
      go(0);
      if (!dialog.open) dialog.showModal();
    };
    const close = () => dialog.close();
    document.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('[data-open-cart]')) {
        e.preventDefault();
        open();
      } else if (t.closest('[data-cart-close]')) close();
    });
    // clique no fundo escuro fecha
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    window.addEventListener('cart:change', () => {
      renderList();
      if (getItems().length === 0) go(0);
    });
    window.addEventListener('cart:open', open);

    // aviso rápido ao adicionar (some sozinho)
    const toast = document.querySelector<HTMLElement>('[data-cart-toast]')!;
    const toastText = document.querySelector<HTMLElement>('[data-cart-toast-text]')!;
    const toastImg = document.querySelector<HTMLImageElement>('[data-cart-toast-img]')!;
    const toastCount = document.querySelector<HTMLElement>('[data-cart-toast-count]')!;
    let timer = 0;
    window.addEventListener('cart:added', (e) => {
      const d = (e as CustomEvent<{ title: string; detail: string; thumb: string; count: number }>).detail;
      toastText.textContent = `${d.title}${d.detail ? ` · ${d.detail}` : ''}`;
      if (d.thumb) toastImg.src = d.thumb;
      toastImg.hidden = !d.thumb;
      toastCount.textContent = String(d.count);
      toast.classList.add('is-on');
      clearTimeout(timer);
      timer = window.setTimeout(() => toast.classList.remove('is-on'), 3200);
    });
    toast.addEventListener('click', () => toast.classList.remove('is-on'));
    renderList();
  }
</script>
