---
// Figma: frame "Velas" (9:125) — vela-<aroma>-100g. Três camadas: sombra, foto do pote e rótulo.
// Posições em % da caixa (proporção 502.32 × 450.02), tiradas de cada frame do Figma.
import type { CandlePhotoSpec } from '../../data/content';

interface Props {
  photo: CandlePhotoSpec;
  alt: string;
  /** Imagem acima da dobra (hero): carrega com prioridade. */
  priority?: boolean;
  class?: string;
}

const { photo, alt, priority = false, class: className = '' } = Astro.props;
const loading = priority ? {} : { loading: 'lazy' as const, decoding: 'async' as const };
const fetchpriority = priority ? { fetchpriority: 'high' as const } : {};
---

<div class:list={['relative aspect-[502.32/450.02]', className]}>
  <img
    src="/img/sombra-vela.svg"
    alt=""
    width="592"
    height="231"
    style={`top:${photo.shadowTop}%;left:${photo.shadowLeft}%`}
    class="pointer-events-none absolute w-[117.79%] max-w-none"
    {...loading}
  />
  <img
    src="/img/pote-100g.webp"
    alt={alt}
    width="1004"
    height="900"
    class="absolute inset-0 size-full"
    {...loading}
    {...fetchpriority}
  />
  <img
    src={`/img/rotulos/${photo.label}.webp`}
    alt=""
    width="517"
    height="472"
    style={`top:${photo.labelTop}%`}
    class="absolute left-[24.19%] w-[51.49%]"
    {...loading}
    {...fetchpriority}
  />
</div>
