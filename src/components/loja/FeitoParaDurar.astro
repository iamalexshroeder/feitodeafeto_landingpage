---
// Loja — "Feito para durar" (Figma 216:191): label + título centralizados e dois destaques com foto (raio 24),
// texto creme por cima, sobre um degradê bordô-escuro que sobe da base. Melhoria: o degradê fica mais
// forte atrás do texto (no Figma ele ainda está a ~50% ali) para garantir AA sobre qualquer foto.
const destaques = [
  {
    titulo: 'Cera 100% vegetal',
    texto: 'Queima limpa e mais lenta, com aroma que fica no ambiente.',
    foto: '/img/floral/pimenta-rosa',
    alt: 'Vela floral Pimenta Rosa acesa, com flores de cera vermelhas',
  },
  {
    titulo: 'Pote que continua com você',
    texto: 'Vidro com tampa de madeira, pronto para reaproveitar depois da última chama.',
    foto: '/img/100g/pimenta-rosa',
    alt: 'Vela de 100g Pimenta Rosa acesa, com a tampa de madeira apoiada no pote',
  },
];
---

<section aria-labelledby="durar-titulo" class="bg-creme pt-16 pb-20 lg:pt-12 lg:pb-24">
  <div class="container-page flex flex-col items-center gap-10 lg:gap-12">
    <div class="flex max-w-[820px] flex-col items-center gap-6 text-center" data-reveal>
      <p class="text-label text-bordo-dark uppercase">Feito para durar</p>
      <h2 id="durar-titulo" class="max-w-[514px] text-h2 text-bordo">
        Feitas à mão, em pequenos lotes. Pensadas para durar.
      </h2>
    </div>
    <ul class="grid w-full gap-5 md:grid-cols-2">
      {destaques.map((d, i) => (
        <li
          class="durar-card relative isolate flex h-[420px] items-end overflow-hidden rounded-[var(--radius-card)] p-8 lg:h-[480px] lg:p-10"
          data-reveal="zoom"
          style={`--reveal-delay: ${i * 120}ms`}
        >
          <img
            src={`${d.foto}.webp`}
            srcset={`${d.foto}-640.webp 640w, ${d.foto}.webp 1200w`}
            sizes="(min-width: 48rem) 590px, 100vw"
            alt={d.alt}
            width="1200"
            height="1120"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-1000 ease-[var(--ease-out-soft)]"
          />
          <span class="durar-veil absolute inset-0 -z-10" aria-hidden="true" />
          <div class="flex max-w-[450px] flex-col gap-2">
            <h3 class="text-h3 text-creme">{d.titulo}</h3>
            <p class="text-creme">{d.texto}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .durar-veil {
    background: linear-gradient(to bottom, rgb(74 18 31 / 0) 40%, rgb(74 18 31 / 0.78) 68%, rgb(74 18 31 / 0.92) 100%);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .durar-card:hover img {
      transform: scale(1.04);
    }
  }
</style>
