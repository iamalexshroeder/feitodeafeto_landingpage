---
// Loja — "Modelos" (Figma 216:205): fundo rosa suave, cabeçalho com label + título à esquerda e texto à
// direita, 4 cards lado a lado (24 entre eles). Celular e tablet: carrossel com encaixe — um card por
// gesto (scroll-snap-stop), sem "puxar" a página junto (overscroll contido) e sem o deslize de entrada nos cards.
import ProductCard from './ProductCard.astro';
import { lojaProdutos, type LojaProduto } from '../../data/loja';

interface Props {
  /** Página de produto: mostra os outros modelos ("Veja também"). */
  produtos?: LojaProduto[];
  label?: string;
  titulo?: string;
  texto?: string;
}
const {
  produtos = lojaProdutos,
  label = 'Os modelos',
  titulo = 'Escolha o tamanho do seu afeto',
  texto = 'Todas feitas à mão, sob encomenda. Monte o seu pedido em poucos cliques.',
} = Astro.props;
---

<section id="modelos" aria-labelledby="vitrine-titulo" class="bg-rosa-soft py-20 lg:py-24">
  <div class="container-page flex flex-col gap-10 lg:gap-12">
    <div
      class="flex flex-col items-center gap-4 text-center lg:flex-row lg:items-end lg:justify-between lg:text-left"
      data-reveal
    >
      <div class="flex max-w-[640px] flex-col items-center gap-4 lg:items-start">
        <p class="text-label text-bordo-dark uppercase">{label}</p>
        <h2 id="vitrine-titulo" class="text-h2 text-bordo">
          {titulo}
        </h2>
      </div>
      <p class="max-w-[340px] text-body-l text-muted lg:text-body">{texto}</p>
    </div>
    <ul
      class="vitrine -mx-[var(--gutter)] flex snap-x snap-mandatory gap-4 overflow-x-auto px-[var(--gutter)] pb-2 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label="Modelos à venda"
    >
      {produtos.map((p, i) => (
        <li class="flex w-[78vw] max-w-[300px] shrink-0 snap-start lg:w-auto lg:max-w-none" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <ProductCard produto={p} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .vitrine {
    scrollbar-width: none;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .vitrine::-webkit-scrollbar {
    display: none;
  }
  .vitrine > li {
    scroll-snap-stop: always;
  }
  /* No carrossel, os cards ficam parados: sem o deslize de entrada que mexia neles ao arrastar. */
  @media (width < 64rem) {
    /* Trava o carrossel na horizontal: sem rolagem para cima/baixo dentro dele (overflow-x: auto
       deixaria o eixo vertical em "auto" e o card "grudava" no dedo ao arrastar). */
    .vitrine {
      overflow-y: hidden;
      touch-action: pan-x pan-y;
      overscroll-behavior-y: none;
    }
    :global(.js) .vitrine > li[data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
