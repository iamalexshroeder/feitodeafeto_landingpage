---
// Loja — melhoria: o menu e o botão "Ver os aromas" do Figma apontam para os aromas, mas a página não tinha
// essa seção. Aqui entra o carrossel de aromas da landing (mesmos cards, mesma pirâmide olfativa).
import AromaCarousel from '../sections/AromaCarousel.astro';
---

<section id="aromas" aria-labelledby="aromas-titulo" class="bg-white pb-10 lg:pb-12">
  <div class="container-page flex flex-col items-center gap-6 pt-16 pb-10 text-center lg:pt-24 lg:pb-12" data-reveal>
    <p class="text-label text-bordo-dark uppercase">Os aromas</p>
    <h2 id="aromas-titulo" class="max-w-[760px] text-h2 text-bordo">
      Cinco aromas e cinco jeitos de dizer afeto
    </h2>
    <p class="max-w-[624px] text-body-l text-muted">
      Todas as velas são de cera vegetal, em pote de vidro, feitas à mão e sob encomenda.
    </p>
  </div>
  <AromaCarousel />
</section>
