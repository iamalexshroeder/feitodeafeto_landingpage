---
// Loja — Figma 215:128: foto de ponta a ponta (1440 × 720), texto alinhado ao topo (y 156), 24 entre os
// blocos, "Comprar agora" preenchido e "Ver os aromas" em contorno. Celular: mesmo padrão do hero da
// landing (foto no topo, base escura e textos claros por cima).
import Button from '../ui/Button.astro';
---

<section
  aria-labelledby="loja-hero-titulo"
  class="relative isolate flex flex-col overflow-hidden bg-ink lg:block lg:min-h-[720px] lg:bg-creme"
>
  <div class="relative aspect-[390/400] w-full md:aspect-[16/10] lg:absolute lg:inset-0 lg:-z-10 lg:aspect-auto">
    <picture>
      <source
        media="(min-width: 64rem)"
        srcset="/img/hero-banner-960.webp 960w, /img/hero-banner.webp 1440w"
        sizes="100vw"
      />
      <source srcset="/img/hero-banner-mobile-520.webp 520w, /img/hero-banner-mobile.webp 780w" sizes="100vw" />
      <img
        src="/img/hero-banner-mobile.webp"
        alt="Vela Pimenta Rosa da Feito de Afeto acesa sobre a mesa de cabeceira, ao lado de um abajur"
        width="780"
        height="800"
        fetchpriority="high"
        class="absolute inset-0 size-full object-cover lg:object-[75%_center]"
      />
    </picture>
    <span class="loja-hero-veil pointer-events-none absolute inset-0 lg:hidden" aria-hidden="true"></span>
  </div>

  <div class="container-page relative -mt-24 pb-10 lg:mt-0 lg:pt-[156px] lg:pb-24">
    <div class="flex max-w-[641px] flex-col items-start gap-8 lg:gap-6">
      <p class="text-label uppercase text-rosa lg:text-bordo-dark">Velas aromáticas artesanais</p>
      <h1 id="loja-hero-titulo" class="text-display text-white lg:text-bordo">
        Velas feitas à mão para perfumar seus momentos de afeto
      </h1>
      <p class="max-w-[520px] text-body-l text-rosa max-lg:-mt-5 lg:text-ink">
        Cera vegetal, aromas marcantes e um pote de vidro que continua com você. Escolha o seu e receba em casa.
      </p>
      <div class="flex w-full flex-wrap gap-4 max-lg:flex-col sm:w-auto lg:pt-2">
        <Button href="#modelos" external={false} class="max-lg:bg-creme max-lg:text-bordo max-lg:hover:bg-white">
          Comprar agora
        </Button>
        <Button
          href="#aromas"
          variant="secondary"
          external={false}
          class="max-lg:text-white max-lg:shadow-none max-lg:bg-white/15 max-lg:backdrop-blur-sm max-lg:hover:bg-white/25"
        >
          Ver os aromas
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .loja-hero-veil {
    background: linear-gradient(
      to bottom,
      rgb(42 20 24 / 0) 30%,
      rgb(42 20 24 / 0.55) 55%,
      rgb(42 20 24 / 0.9) 72%,
      rgb(42 20 24) 92%
    );
  }
</style>
