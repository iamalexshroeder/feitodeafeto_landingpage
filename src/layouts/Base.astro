---
import SEO from '../components/SEO.astro';
import JsonLd, { type FaqItem } from '../components/JsonLd.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  faq?: FaqItem[];
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  noindex,
  faq,
} = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} noindex={noindex} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      imagesrcset="/img/hero-banner-960.webp 960w, /img/hero-banner.webp 1440w"
      imagesizes="100vw"
      media="(min-width: 64rem)"
      fetchpriority="high"
    />
    <script is:inline>
      // Efeitos ao rolar: marca o <html> e revela [data-reveal] ao entrar na tela.
      document.documentElement.classList.add('js');
      addEventListener('DOMContentLoaded', () => {
        const items = [...document.querySelectorAll('[data-reveal]')];
        const show = (el) => el.classList.add('is-visible');
        if (!('IntersectionObserver' in window)) return items.forEach(show);
        // O que já está na tela ao carregar aparece direto, sem esperar o observer.
        const pending = items.filter((el) => (el.getBoundingClientRect().top < innerHeight ? (show(el), false) : true));
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        pending.forEach((el) => io.observe(el));
      });
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!noindex && <JsonLd title={title} description={description} faq={faq} />}
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <slot name="header" />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
