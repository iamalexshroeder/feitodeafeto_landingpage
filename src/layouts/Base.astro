---
import SEO from '../components/SEO.astro';
import JsonLd, { type FaqItem, type ProductItem } from '../components/JsonLd.astro';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  faq?: FaqItem[];
  products?: ProductItem[];
}

const { title = site.defaultTitle, description = site.defaultDescription, noindex, faq, products } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} noindex={noindex} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      imagesrcset="/img/hero-banner-960.webp 960w, /img/hero-banner.webp 1440w"
      imagesizes="100vw"
      media="(min-width: 64rem)"
      fetchpriority="high"
    />
    <script is:inline>
      // Efeitos ao rolar: marca o <html> e revela [data-reveal] ao entrar na tela.
      document.documentElement.classList.add('js');
      addEventListener('DOMContentLoaded', () => {
        const items = [...document.querySelectorAll('[data-reveal]')];
        const show = (el) => el.classList.add('is-visible');
        if (!('IntersectionObserver' in window)) return items.forEach(show);
        // O que já está na tela ao carregar aparece direto, sem esperar o observer.
        const pending = items.filter((el) =>
          el.getBoundingClientRect().top < innerHeight ? (el.classList.add('is-instant'), show(el), false) : true,
        );
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        pending.forEach((el) => io.observe(el));
      });

      // Métrica de conversão: cada clique em link do WhatsApp vira um evento "whatsapp_click" no
      // dataLayer (GTM/GA4) e no Plausible, se algum estiver instalado. Nenhum script de terceiro aqui.
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', (e) => {
        const link = e.target instanceof Element && e.target.closest('a[href^="https://wa.me/"]');
        if (!link) return;
        const where = link.closest('[id]');
        const data = {
          location: where ? where.id : 'pagina',
          item: link.dataset.trackItem || '',
          label: link.textContent.replace('(abre o WhatsApp)', '').trim(),
        };
        window.dataLayer.push({ event: 'whatsapp_click', ...data });
        if (typeof window.plausible === 'function') window.plausible('WhatsApp', { props: data });
      });
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!noindex && <JsonLd title={title} description={description} faq={faq} products={products} />}
  </head>
  <body>
    <a href="#conteudo" class="skip-link">
      Pular para o conteúdo
    </a>
    <slot name="header" />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
